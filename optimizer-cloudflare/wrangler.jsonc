{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aabenbane-optimizer",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "workflows": [{"binding":"OPTIMIZER_JOBS","name":"aabenbane-optimizer-jobs","class_name":"OptimizerWorkflow"}],
  "d1_databases": [{"binding":"DB","database_name":"aabenbaneaften","database_id":"f6e9f950-cd58-4c81-b707-98cd1753c800","migrations_dir":"../drizzle"}],
  "containers": [{
    "class_name": "OptimizerContainer",
    "image": "../optimizer-service/Dockerfile",
    "instance_type": "standard-4",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{ "name": "OPTIMIZER", "class_name": "OptimizerContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OptimizerContainer"] }]
}
