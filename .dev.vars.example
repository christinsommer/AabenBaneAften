NEXTJS_ENV=development
# Run node scripts/setup-mfa.mjs --local to generate an isolated local MFA key.
# Production needs a separate 64-hex-character MFA_ENCRYPTION_KEY Worker secret.
# RESEND_API_KEY=your-local-test-key
# OPTIMIZER_URL=http://127.0.0.1:5117
# OPTIMIZER_API_KEY=use-the-same-secret-as-the-optimizer-service-at-least-32-characters

# Enable only after privacy/drift review; tests must keep this false.
NEWSLETTER_ENABLED=false

# Deployment-owned internal player ID. Never use an editable name or a member number.
# SUPERADMIN_PLAYER_ID=verified-internal-player-id
